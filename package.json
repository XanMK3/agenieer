{
  "name": "agenieer",
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "agenieer": "./dist/cli.js"
  },
  "files": [
    "dist",
    "templates"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup src/cli.ts --format esm --out-dir dist --dts",
    "prepare": "npm run build",
    "test": "vitest run",
    "dev": "tsup src/cli.ts --format esm --out-dir dist --watch"
  },
  "dependencies": {
    "@clack/prompts": "^0.11.0",
    "commander": "^14.0.3",
    "fast-glob": "^3.3.3"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsup": "^8.4.0",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
}
